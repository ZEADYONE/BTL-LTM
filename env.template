# Copy this file to .env before running Docker Compose.

# Existing MySQL 8 server (not started by this stack). Create the database and user
# once (see README); the game server creates its tables on first start.
# Use host.docker.internal when MySQL runs on the same machine as Docker.
BOMBERMAN_DB_HOST=
BOMBERMAN_DB_PORT=3306
BOMBERMAN_DB_NAME=bomberman_online
BOMBERMAN_DB_USERNAME=bomberman
BOMBERMAN_DB_PASSWORD=replace_with_the_database_password

# Public game port. Only expose it through the router/firewall when remote players
# need access.
BOMBERMAN_TCP_PORT=8081

# Website (landing page + client download), published on BOMBERMAN_WEB_PORT.
# BOMBERMAN_PUBLIC_HOST is the hostname/IP players type into the game's SERVER ADDRESS
# popup (e.g. a DDNS name). Leave it empty to reuse the hostname of the website URL;
# set it when the website goes through a proxy such as Cloudflare and the game does not.
# BOMBERMAN_PUBLIC_PORT is only needed when the router forwards a different external port.
BOMBERMAN_WEB_PORT=80
BOMBERMAN_PUBLIC_HOST=
# BOMBERMAN_PUBLIC_PORT=8081
BOMBERMAN_REPO_URL=

# Optional image/runtime tuning.
BOMBERMAN_IMAGE_TAG=latest
BOMBERMAN_JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8
