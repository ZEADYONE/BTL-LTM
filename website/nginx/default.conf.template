# Rendered at container start by the nginx image (envsubst) into /etc/nginx/conf.d/default.conf.
# Only ${BOMBERMAN_*} variables are substituted (NGINX_ENVSUBST_FILTER), so nginx's own
# variables such as $uri are left untouched.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    charset utf-8;
    charset_types text/css application/javascript application/json text/plain;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml font/ttf text/plain;

    # Locations below set caching with "expires" only: an add_header inside a location
    # would silently drop these server-level headers.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'" always;

    # HTML, CSS and JS file names carry no version, so browsers revalidate them.
    location / {
        try_files $uri $uri/ =404;
        expires -1;
    }

    # Server address shown on the page, taken from .env through docker-compose.yml.
    location = /config.js {
        default_type application/javascript;
        expires -1;
        return 200 'window.BOMBERMAN_CONFIG = {"host": "${BOMBERMAN_PUBLIC_HOST}", "port": "${BOMBERMAN_PUBLIC_PORT}", "repoUrl": "${BOMBERMAN_REPO_URL}"};\n';
    }

    location /assets/ {
        expires 7d;
    }

    location /fonts/ {
        types {
            font/ttf ttf;
            text/plain txt;
        }
        expires 30d;
    }

    # Read-only bind mount of ./downloads. A rebuild can change the ZIP without changing
    # its version, so it is revalidated too; otherwise it would not match release.json.
    location /downloads/ {
        types {
            application/zip zip;
            application/json json;
            text/plain sha256;
        }
        expires -1;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok\n';
    }
}
